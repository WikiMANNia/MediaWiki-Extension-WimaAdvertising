{
	"name": "WimaAdvertising",
	"author": "[//wikimannia.org WikiMANNia]",
	"url": "https://www.mediawiki.org/wiki/Extension:WimaAdvertising",
	"license-name": "GPL-2.0-or-later",
	"version": "2.11.0",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"namemsg": "wimaadvertising-msg",
	"descriptionmsg": "wimaadvertising-desc",
	"callback": "MediaWiki\\Extension\\WimaAdvertising\\Hooks::onRegistration",
	"ConfigRegistry": {
		"wimaadvertising": "GlobalVarConfig::newInstance"
	},
	"config": {
		"WimaAdvertising": {
			"type": "boolean",
			"value": false
		},
		"WimaAdvertisingAnonOnly": {
			"type": "boolean",
			"value": false
		},
		"BannerBottomCode": {
			"type": "string",
			"value": "",
			"description": "Insert the HTML code for your Ad at the bottom in this variable."
		},
		"BannerBottomStyle": {
			"type": "string",
			"value": "border:1px solid black; text-align:center;"
		},
		"BannerBottomType": {
			"type": "string",
			"value": "advertising"
		},
		"BannerTopCode": {
			"type": "string",
			"value": "",
			"description": "Insert the HTML code for your Ad at the top in this variable."
		},
		"BannerTopStyle": {
			"type": "string",
			"value": "border:1px solid black; text-align:center;"
		},
		"BannerTopType": {
			"type": "string",
			"value": "advertising"
		},
		"SidebarAd1Code": {
			"type": "string",
			"value": "",
			"description": "Insert the HTML code for your Ad 1 in the sidebar in this variable."
		},
		"SidebarAd1Style": {
			"type": "string",
			"value": ""
		},
		"SidebarAd1Type": {
			"type": "string",
			"value": "advertising"
		},
		"SidebarAd2Code": {
			"type": "string",
			"value": "",
			"description": "Insert the HTML code for your Ad 2 in the sidebar in this variable."
		},
		"SidebarAd2Style": {
			"type": "string",
			"value": ""
		},
		"SidebarAd2Type": {
			"type": "string",
			"value": "advertising"
		},
		"GoogleAdSense": {
			"type": "boolean",
			"value": false
		},
		"GoogleAdSenseAnonOnly": {
			"type": "boolean",
			"value": false
		},
		"GoogleAdSenseClient": {
			"type": "string",
			"value": "none"
		},
		"GoogleAdSenseHost": {
			"type": "string",
			"value": "none"
		},
		"GoogleAdSenseMode": {
			"type": "string",
			"value": "normal"
		},
		"GoogleAdSenseSlot": {
			"type": "string",
			"value": "none"
		},
		"GoogleAdSenseSrc": {
			"type": "string",
			"value": "//pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"
		},
		"GoogleAdSense_Bottom": {
			"type": "array",
			"value": [],
			"description": "[ 'slotid' (string), width (int), height (int), 'auto, rectangle, vertical, rectangle' (optional) ], i.e.: [ 'slotid 1', 145, 260 ]"
		},
		"GoogleAdSense_Top": {
			"type":  "array",
			"value": [],
			"description": "[ 'slotid', width, height, 'format' (optional) ], i.e.: [ 'slotid 2', 145, 260, 'rectangle' ]"
		},
		"GoogleAdSense_AD1": {
			"type":  "array",
			"value": [],
			"description": "[ 'slotid', width, height, 'format' (optional) ], i.e.: [ 'slotid 3', 600, 160, 'horizontal' ]"
		},
		"GoogleAdSense_AD2": {
			"type":  "array",
			"value": [],
			"description": "[ 'slotid', width, height, 'format' (optional) ], i.e.: [ 'slotid 4', 145, 260, 'vertical, rectangle' ]"
		}
	},
	"manifest_version": 2,
	"type": "other",
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WimaAdvertising\\": "includes/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\WimaAdvertising\\Hooks"
		}
	},
	"Hooks": {
	    "BeforePageDisplay": "main",
		"MonacoSidebarEnd": "main",
		"MonacoStaticboxEnd": "main",
		"SidebarBeforeOutput": "main",
		"SiteNoticeAfter": "main",
	    "SkinAfterContent": "main",
	    "SkinAfterPortlet": "main"
	},
	"MessagesDirs": {
		"WimaAdvertising": [ "i18n" ]
	},
	"ResourceModules": {
		"ext.wimaadvertising.common": {
			"styles": "css/Common.css"
		},
		"ext.wimaadvertising.citizen": {
			"styles": "css/Citizen.css"
		},
		"ext.wimaadvertising.cologneblue": {
			"styles": "css/Cologneblue.css"
		},
		"ext.wimaadvertising.mobile": {
			"styles": "css/Mobile.css"
		},
		"ext.wimaadvertising.minerva": {
			"styles": "css/Minerva.css"
		},
		"ext.wimaadvertising.modern": {
			"styles": "css/Modern.css"
		},
		"ext.wimaadvertising.monaco": {
			"styles": "css/Monaco.css"
		},
		"ext.wimaadvertising.monobook": {
			"styles": "css/Monobook.css"
		},
		"ext.wimaadvertising.timeless": {
			"styles": "css/Timeless.css"
		},
		"ext.wimaadvertising.vector": {
			"styles": "css/Vector.css"
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "WimaAdvertising/resources"
	}
}
